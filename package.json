{
  "name": "nexus-ai",
  "version": "0.3.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "accounts": "node --env-file=.env scripts/show-accounts.mjs",
    "dev": "npm run dev --workspace @nexus/web",
    "build": "npm run build --workspace @nexus/web",
    "typecheck": "npm run typecheck --workspace @nexus/web",
    "test": "npm run test --workspace @nexus/web",
    "api": "node --env-file=.env scripts/run-api.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
